# ==============================================================================
# SPOTLY CHILE - VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ==============================================================================

# Supabase Producción
VITE_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]

# Google Gemini API (Backend)
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]

# Producción Server / Deploy
PORT=3000
NODE_ENV=production

# Si frontend y backend están en dominios separados (ej: Frontend en Vercel, Backend en Render):
# VITE_API_URL=https://spotly-backend.onrender.com
# CORS_ORIGIN=https://spotly-chile.vercel.app
VITE_API_URL=
CORS_ORIGIN=*

# 4. Pagos Webpay Plus y backend de pagos (Vercel Functions o server.ts)
# Clave service_role de Supabase (Project Settings -> API). SOLO en el backend;
# nunca con prefijo VITE_. La usan /api/webpay para registrar pagos y reembolsos.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# "integration" (por defecto, credenciales públicas de prueba de Transbank) o "production".
WEBPAY_ENV=integration
# Solo en producción (código de comercio y llave secreta entregados por Transbank).
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# URL pública de la app (opcional; por defecto se usa el host de la solicitud).
PUBLIC_APP_URL=
