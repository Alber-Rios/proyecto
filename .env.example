# ==============================================================================
# SPOTLY CHILE - VARIABLES DE ENTORNO
# ==============================================================================

# 1. Supabase (Base de datos PostgreSQL, Supabase Auth y Supabase Storage)
# Obtén estas credenciales en: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-de-supabase

# 2. Configuración de Red y Backend (Opcional en desarrollo local)
# Puerto en el que escucha el servidor Node.js/Express
PORT=3000
NODE_ENV=development

# Si despliegas el frontend en Vercel y el backend en Render/Railway, define la URL pública del backend:
# VITE_API_URL=https://spotly-backend.onrender.com
VITE_API_URL=

# Dominio permitido para CORS en el backend (por ejemplo: https://tu-frontend.vercel.app)
CORS_ORIGIN=*

# 3. Pagos Webpay Plus y backend de pagos (Vercel Functions o server.ts)
# Clave service_role de Supabase (Project Settings -> API). SOLO en el backend;
# nunca con prefijo VITE_. La usan /api/webpay para registrar pagos y reembolsos.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# "integration" (por defecto, credenciales públicas de prueba de Transbank) o "production".
WEBPAY_ENV=integration
# Solo en producción (código de comercio y llave secreta entregados por Transbank).
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# Billetera (Oneclick Mall). En integración se usan las credenciales públicas de prueba.
# En producción: código del comercio mall, código de la tienda hija y llave secreta.
ONECLICK_COMMERCE_CODE=
ONECLICK_CHILD_COMMERCE_CODE=
ONECLICK_API_KEY=
# URL pública de la app (opcional; por defecto se usa el host de la solicitud).
PUBLIC_APP_URL=

# Dominio público para generar sitemap.xml y robots.txt en el build (ej: https://spotly.cl).
# En Vercel se usa automáticamente el dominio de producción si no se define.
SITE_URL=
